{
  "name": "ola-onboarding-wizard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OLA Onboarding Wizard - Turbonomic assessment for AWS migration (React UI + local Node API, hosted on Windows)",
  "scripts": {
    "dev": "concurrently -k -n api,ui \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
